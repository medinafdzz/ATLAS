[Unit]
Description=ATLAS private infrastructure dashboard
After=network.target
[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/var/lib/atlas
EnvironmentFile=/etc/atlas/atlas.env
ExecStart=/opt/atlas/venv/bin/atlas serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atlas
UMask=0077
[Install]
WantedBy=multi-user.target
